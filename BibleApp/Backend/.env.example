# ShopiaAI Bible App - Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
# Development: http://localhost:5173
# Production: Your deployed frontend URL
FRONTEND_URL=http://localhost:5173

# Supabase Configuration
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key

# DeepSeek AI Configuration
# Get this from DeepSeek AI platform
DEEPSEEK_API_KEY=your-deepseek-api-key

# PayPal Configuration
# Get these from PayPal Developer Dashboard
# Use sandbox credentials for testing, live credentials for production
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox
# PAYPAL_MODE options: sandbox or live
